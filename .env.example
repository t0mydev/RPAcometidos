# Configuración de Entorno RPA Cometidos

# MODO DE SIMULACIÓN / DEMO
# true  -> Emite progreso paso a paso para el stepper y la terminal sin abrir portales reales (ideal para videos/demos)
# false -> Ejecuta la automatización real con Playwright contra los portales MOP (SSD, Personal, Firmador)
MODO_SIMULACION=true

# SIMULAR FALLO EN PRIMER COMETIDO (Solo aplica cuando MODO_SIMULACION=true)
# true  -> Simula que el primer cometido falla en la atribución para demostrar que el robot no se cae y avanza al segundo
# false -> Simula todos los cometidos exitosos de principio a fin
SIMULAR_FALLO=true
